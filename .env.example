# Crystal Shield Hub — environment for Dokploy (Environment tab). Copy, fill in, paste.

# Public address — used in quotation / invoice / warranty links sent to customers
APP_URL=https://hub.crystalshield.ae

# First admin account (created on the very first start only)
ADMIN_EMAIL=admin@crystalshield.ae
ADMIN_PASSWORD=change-me-min-8-characters

# Already set in the Dockerfile — only change if you know why
PORT=4200
DATA_DIR=/app/data

# Optional: email can also be set later in the hub (Settings → Email & WhatsApp), which is easier
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=hub@crystalshield.ae
# SMTP_PASS=
# SMTP_FROM=Crystal Shield <enquiry@crystalshield.ae>

# Password recovery: set to 1 together with ADMIN_EMAIL + ADMIN_PASSWORD, redeploy, sign in, then REMOVE it
# ADMIN_RESET=1
